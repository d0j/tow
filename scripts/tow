#!/bin/sh
# TOW with this install's environment on Linux and macOS, e.g. `./tow doctor`, `./tow keys adopt`.
# `./tow setup` installs Python and TOW's environment inside the install (after a move, a fresh
# clone or a new Python version); it needs uv (runtime/bin/uv or on PATH). See docs/PORTABLE.md.
#
#   TOW_APP   the code: the folder above this script
#   TOW_ROOT  the install: app/, config.yaml, data/, keys/, backup/, runtime/ (in a development
#             checkout the checkout itself)
set -eu

self=$0
while [ -L "$self" ]; do  # started through a link (e.g. ~/bin/tow): find the real script
    link=$(readlink -- "$self")
    case $link in
        /*) self=$link ;;
        *) self=$(dirname -- "$self")/$link ;;
    esac
done
TOW_APP=$(CDPATH='' cd -- "$(dirname -- "$self")/.." && pwd -P)

# A TOW_ROOT set before (a variable of the whole account, left from a move or another install) is
# kept only when it names the folder above this code folder; the code folder itself (older
# launchers set that) is found again below. Another folder would get a new data/ and master key,
# and TOW would start there with no data.
if [ -n "${TOW_ROOT:-}" ]; then
    given=$(CDPATH='' cd -- "$TOW_ROOT" 2>/dev/null && pwd -P) || given=
    if [ "$given" = "$(dirname -- "$TOW_APP")" ]; then
        TOW_ROOT=$given
    else
        if [ "$given" != "$TOW_APP" ]; then
            echo "TOW: TOW_ROOT=$TOW_ROOT is not the folder of this TOW, so it is ignored. Remove the variable if it is left from a move or another install." >&2
        fi
        TOW_ROOT=
    fi
fi
if [ -z "${TOW_ROOT:-}" ]; then
    TOW_ROOT=$TOW_APP
    parent=$(dirname -- "$TOW_APP")
    # The code folder's name in any case, as tow.paths and tow-env.cmd read it ("App" too).
    case $(basename -- "$TOW_APP") in
        [Aa][Pp][Pp])
            if [ -f "$parent/config.yaml" ] || [ -d "$parent/data" ]; then
                TOW_ROOT=$parent
            fi
            ;;
    esac
fi
export TOW_ROOT
export PYTHONIOENCODING=utf-8

# uv, Python and uv's cache inside the install (a development checkout keeps the user's uv setup).
uv=uv
if [ -x "$TOW_ROOT/runtime/bin/uv" ]; then
    uv=$TOW_ROOT/runtime/bin/uv
fi
if [ "$TOW_ROOT" != "$TOW_APP" ]; then
    export UV_PYTHON_INSTALL_DIR="$TOW_ROOT/runtime/python"
    export UV_PYTHON_BIN_DIR="$TOW_ROOT/runtime/bin"
    export UV_CACHE_DIR="$TOW_ROOT/runtime/cache"
    export UV_PROJECT_ENVIRONMENT="$TOW_APP/.venv"
    export UV_MANAGED_PYTHON=1
fi

# An update cut off while it replaced the code (the rule of scripts/tow-start): app/ may hold half of
# the new code and no environment. Setup, or uv without an environment, would build one from it (a
# raw uv error and a stray app/.venv); TOW's own environment says it itself (`tow status`, `tow start`).
interrupted() {
    [ -f "$TOW_ROOT/.update-switch.json" ] || return 1
    if grep -Eq '"phase": *"accepted"|"restored": *true' "$TOW_ROOT/.update-switch.json" 2>/dev/null; then
        return 1
    fi
    [ -f "$TOW_ROOT/.update.lock" ] || return 0
    if command -v flock >/dev/null 2>&1; then
        flock -n "$TOW_ROOT/.update.lock" true 2>/dev/null || return 1
    elif command -v perl >/dev/null 2>&1; then
        perl -MFcntl=:flock -e 'open(my $f, "<", $ARGV[0]) or exit 0; exit(flock($f, LOCK_EX | LOCK_NB) ? 0 : 1)' \
            "$TOW_ROOT/.update.lock" 2>/dev/null || return 1
    fi
    return 0
}
refuse_interrupted() {
    if interrupted; then
        echo "TOW cannot run: an update was cut off while it replaced the code in $TOW_ROOT. Run the update there again (update-tow, or \"Update TOW.command\" on macOS): it puts the previous version back first." >&2
        exit 3
    fi
}

if [ "${1:-}" = setup ]; then
    refuse_interrupted
    shift
    if [ $# -gt 0 ]; then
        echo "Usage: ./tow setup (no options): Python and TOW's environment inside the install; run it with TOW stopped." >&2
        exit 2
    fi
    if ! command -v "$uv" >/dev/null 2>&1; then
        echo "TOW setup: uv was not found. Put it into $TOW_ROOT/runtime/bin/uv or on PATH." >&2
        exit 3
    fi
    cd -- "$TOW_APP"
    if [ "$TOW_ROOT" = "$TOW_APP" ]; then
        exec "$uv" sync --frozen
    fi
    # Never under a running TOW: its environment would be replaced while it runs. Another program
    # or TOW folder on the port is only named (setup_check prints it); an older .venv has busy().
    if [ -x .venv/bin/python ]; then
        status=0
        .venv/bin/python -c 'import sys; from tow.supervisor import layout as l; sys.exit(l.setup_check() if hasattr(l, "setup_check") else 4 if l.busy() else 0)' 2>/dev/null || status=$?
        if [ "$status" -eq 4 ]; then
            echo "TOW setup: TOW is running from this folder. Stop it first (./tow stop), then run setup again." >&2
            exit 3
        fi
    fi
    # .venv holds absolute paths: built again when its Python no longer runs (a moved folder) or
    # is not the one inside the install (an install from before 1.18).
    inside='import os, sys; base=os.path.normcase(os.path.realpath(sys.base_prefix)); managed=os.path.normcase(os.path.realpath(os.environ["UV_PYTHON_INSTALL_DIR"])); sys.exit(os.path.commonpath([base,managed]) != managed)'
    if [ -e .venv/bin/python ] && ! .venv/bin/python -c "$inside" >/dev/null 2>&1; then
        rm -rf .venv
    fi
    # A copied install (docs/PORTABLE.md 3) may hold uv's minor-version link
    # runtime/python/cpython-X.Y-* as a plain folder (a copy that followed links, a stick without
    # links): uv cannot make the link again. Only that entry, only a plain folder, only here.
    for entry in "$TOW_ROOT"/runtime/python/cpython-*; do
        version=${entry##*/cpython-}
        version=${version%%-*}
        case $version in
            *.*.* | *[!0-9.]*) continue ;;
            *.*) ;;
            *) continue ;;
        esac
        if [ -d "$entry" ] && [ ! -L "$entry" ]; then
            rm -rf -- "$entry"
        elif [ -L "$entry" ]; then
            # A moved install keeps the link to the old folder (an absolute path): the link alone
            # goes when it points outside this install, and uv makes it again here.
            case $(readlink -- "$entry") in
                "$TOW_ROOT"/runtime/python/* | cpython-*) ;;
                *) rm -f -- "$entry" ;;
            esac
        fi
    done
    # The Python of .python-version, into runtime/python; no copies on PATH.
    "$uv" python install --no-bin
    "$uv" sync --frozen --no-dev
    # First start: TOW creates its master key (keys/master.key) and says to keep a copy of it.
    exec "$TOW_APP/.venv/bin/tow" keys ensure
fi

if [ -x "$TOW_APP/.venv/bin/tow" ]; then
    # The environment must be this folder's own, as scripts/tow-start checks it: its Python runs,
    # TOW's code (and in an install the base Python) lies inside the folder. A moved folder's
    # environment points to the old place; a copy's, while the original is still there, runs the
    # original's code with this folder's data, and could stop the original's web server.
    here_check='import os, sys, importlib.util as u; n = lambda p: os.path.normcase(os.path.realpath(p)); here = n(os.environ["TOW_HERE"]); spec = u.find_spec("tow"); found = [spec.origin] if spec and spec.origin else []; found += [sys.base_prefix] if here != n(os.environ["TOW_APP"]) else []; sys.exit(0 if spec and spec.origin and all(n(p).startswith(here + os.sep) for p in found) else 1)'
    if ! TOW_HERE=$TOW_ROOT TOW_APP=$TOW_APP "$TOW_APP/.venv/bin/python" -I -c "$here_check" >/dev/null 2>&1; then
        echo "TOW's environment still belongs to the folder TOW was moved or copied from. Run \"$TOW_APP/scripts/tow\" setup first." >&2
        exit 3
    fi
    exec "$TOW_APP/.venv/bin/tow" "$@"
fi
# Not set up yet: uv runs TOW from the locked environment.
refuse_interrupted
exec "$uv" run --frozen --no-dev --project "$TOW_APP" tow "$@"
